model Payslip {
  id                 String @id @default(cuid())
  employeeId         String
  attendancePeriodId String

  baseSalary       Decimal @db.Decimal(10, 2)
  attendanceDays   Int     @default(0)
  totalWorkingDays Int     @default(0)
  attendanceSalary Decimal @default(0) @db.Decimal(10, 2)

  totalOvertimeHours Decimal @default(0) @db.Decimal(5, 2)
  overtimeRate       Decimal @default(1.5) @db.Decimal(3, 2)
  overtimeAmount     Decimal @default(0) @db.Decimal(10, 2)

  totalReimbursements Decimal @default(0) @db.Decimal(10, 2)

  grossPay   Decimal @default(0) @db.Decimal(10, 2)
  deductions Decimal @default(0) @db.Decimal(10, 2)
  netPay     Decimal @default(0) @db.Decimal(10, 2)

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendancePeriod AttendancePeriod @relation(fields: [attendancePeriodId], references: [id], onDelete: Cascade)

  @@unique([employeeId, attendancePeriodId])
  @@map("payslips")
}
